# One-time setup on the VPS: `cp .env.example .env`, fill in every value
# below, then `docker compose up -d --build`. This file itself is
# git-ignored and untouched by `git pull` — every deploy after this first
# one is just `git pull && docker compose up -d --build`.

# --- Public address (Caddy) ---
# No domain yet:  SITE_ADDRESS=:80   -> app on http://<server-ip>
# With a domain:  SITE_ADDRESS=app.example.com  -> automatic HTTPS (point
#                 the DNS A record at the server first)
SITE_ADDRESS=:80

# --- Database ---
DB_NAME=refurbincstest
DB_USER=postgres
# Generate with: openssl rand -base64 24
DB_PASSWORD=change-me
# Managed Postgres (DATABASE_URL) only: 'true' also verifies the server's TLS
# certificate. Optional DB_SSL_CA = path to a PEM file, or the PEM text.
DB_SSL_VERIFY=false
DB_SSL_CA=

# --- Backend (Express API) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# The public URL the browser opens the app at, for CORS:
# http://<server-ip> (IP only) or https://app.example.com (domain).
CLIENT_URL=http://1.2.3.4

# --- Outgoing email (optional; invoices & notifications) ---
# Leave empty to disable. Gmail: smtp.gmail.com / 465 / SMTP_SECURE=true + app password.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Uploaded files (optional object storage) ---
# Empty → files go to backend/uploads on local disk (fine with a persistent
# disk/volume at /app/uploads). Set STORAGE_BUCKET to keep them in an
# S3-compatible bucket instead (AWS S3, Cloudflare R2, Backblaze B2, MinIO…).
# Copy existing files once: node backend/scripts/migrate-uploads-to-bucket.js
STORAGE_BUCKET=
# R2: https://<account-id>.r2.cloudflarestorage.com — leave empty for AWS S3
STORAGE_ENDPOINT=
# AWS region (e.g. eu-west-2); R2 uses "auto"
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Frontend (baked into the static bundle at build time) ---
# The public URL the browser reaches the API at — same origin as CLIENT_URL
# plus /api (Caddy path-routes /api to the backend).
VITE_API_URL=http://1.2.3.4/api

# --- Easy Login / Quick Fill Defaults (for dev/demo) ---
VITE_DEFAULT_LOGIN_EMAIL=superadmin@gmail.com
VITE_DEFAULT_LOGIN_PASSWORD=
# Password used by every quick-fill button (local dev only — never commit it)
VITE_DEMO_PASSWORD=
VITE_DEMO_SUPERADMIN_EMAIL=superadmin@gmail.com
VITE_DEMO_CLIENT_EMAIL=humanforest@gmail.com
VITE_DEMO_RECYCLE_EMAIL=recycle@gmail.com

# --- App mode (switch by hand) ---
# development → quick-login buttons on the login page
# production  → hidden (even on the local dev server)
# empty       → follows the build: on with `npm run dev`, off when built
VITE_APP_MODE=
