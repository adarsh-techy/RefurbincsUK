# Reverse proxy for the whole stack on ONE address, path-routed:
#   /api/*, /uploads/*, /socket.io/*, /health  -> backend:5000
#   everything else                            -> frontend:8080 (React SPA)
#
# SITE_ADDRESS comes from .env:
#   :80              plain HTTP on the server's IP (no domain yet)
#   app.example.com  automatic HTTPS via Let's Encrypt (point the DNS A
#                    record at this server first, or Caddy can't issue a cert)

{$SITE_ADDRESS} {
	encode gzip

	@backend path /api/* /uploads/* /socket.io/* /health
	handle @backend {
		reverse_proxy backend:5000
	}

	handle {
		reverse_proxy frontend:8080
	}
}
