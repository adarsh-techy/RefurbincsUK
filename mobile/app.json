{
  "expo": {
    "name": "Refurbinics",
    "slug": "refurbinics-technician",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "refurbinics-technician",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.refurbinics.technician",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Refurbinics needs camera access to scan battery QR codes."
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "b0487851-7e26-4be5-addb-8202b21bb646"
      }
    },
    "owner": "work.adarsh"
  }
}
