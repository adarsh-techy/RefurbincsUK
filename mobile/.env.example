# Copy this file to .env and point it at your backend. mobile/.env is
# git-ignored (root .gitignore), so keep real values there, not here.

# Base URL of the backend API, including the /api prefix. Expo only exposes
# env vars prefixed with EXPO_PUBLIC_ to app code (see src/services/api-client.js),
# and — like Vite's VITE_ vars — it's baked in at build time.
#   - Expo Go / dev build on a physical device: http://<your-lan-ip>:5000/api
#     (must be your computer's LAN IP, not localhost — the phone is a
#     separate device on the network)
#   - Production build:                          https://<your-backend-domain>/api
EXPO_PUBLIC_API_URL=http://192.168.31.234:5000/api

# Password for the dev-only quick-fill login buttons (never commit it)
EXPO_PUBLIC_DEMO_PASSWORD=

# App mode (switch by hand): development → quick-login buttons on,
# production → off, empty → follows the build (__DEV__).
# Restart with `npx expo start -c` after changing it.
EXPO_PUBLIC_APP_MODE=

# Website address printed inside QR codes (like the web QR sheet). Empty → QR holds just the battery code.
EXPO_PUBLIC_WEB_URL=
